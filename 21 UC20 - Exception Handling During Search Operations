import java.util.Scanner;

public class TrainAppUC20 {

    public static void main(String[] args) {
        System.out.println("🚆 Welcome to the Train Consist Management App!");
        System.out.println("Defensive search validation...\n");

        // Example: empty bogie collection
        String[] bogieIDs = {}; // no bogies present

        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter bogie ID to search: ");
        String searchKey = scanner.nextLine();

        // Defensive check before search
        if (bogieIDs.length == 0) {
            throw new IllegalStateException("❌ Cannot perform search: Train has no bogies.");
        }

        // Binary search logic (if not empty)
        int low = 0;
        int high = bogieIDs.length - 1;
        boolean found = false;

        while (low <= high) {
            int mid = (low + high) / 2;
            int comparison = searchKey.compareTo(bogieIDs[mid]);

            if (comparison == 0) {
                System.out.println("✅ Bogie ID " + searchKey + " found at position " + mid);
                found = true;
                break;
            } else if (comparison < 0) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        if (!found) {
            System.out.println("❌ Bogie ID " + searchKey + " not found in the train consist.");
        }

        scanner.close();
    }
}
