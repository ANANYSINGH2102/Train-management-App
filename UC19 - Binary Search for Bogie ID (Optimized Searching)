import java.util.Arrays;
import java.util.Scanner;

public class TrainAppUC19 {

    public static void main(String[] args) {
        System.out.println("🚆 Welcome to the Train Consist Management App!");
        System.out.println("Searching bogie IDs using Binary Search...\n");

        // Sorted array of bogie IDs
        String[] bogieIDs = {"BG101", "BG205", "BG309", "BG412", "BG550"};

        System.out.println("Available bogie IDs: " + Arrays.toString(bogieIDs));

        // Accept search key from user
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter bogie ID to search: ");
        String searchKey = scanner.nextLine();

        // Binary search logic
        int low = 0;
        int high = bogieIDs.length - 1;
        boolean found = false;

        while (low <= high) {
            int mid = (low + high) / 2;
            int comparison = searchKey.compareTo(bogieIDs[mid]);

            if (comparison == 0) {
                System.out.println("✅ Bogie ID " + searchKey + " found at position " + mid);
                found = true;
                break;
            } else if (comparison < 0) {
                high = mid - 1; // search left half
            } else {
                low = mid + 1; // search right half
            }
        }

        if (!found) {
            System.out.println("❌ Bogie ID " + searchKey + " not found in the train consist.");
        }

        scanner.close();
    }
}
