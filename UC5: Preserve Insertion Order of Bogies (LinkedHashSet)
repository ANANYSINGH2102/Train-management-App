import java.util.LinkedHashSet;
import java.util.Set;

public class TrainAppUC5 {

    public static void main(String[] args) {
        System.out.println("🚆 Welcome to the Train Consist Management App!");
        System.out.println("Preserving insertion order of bogies...\n");

        // Create a LinkedHashSet for train formation
        Set<String> trainFormation = new LinkedHashSet<>();

        // Attach bogies
        trainFormation.add("Engine");
        trainFormation.add("Sleeper");
        trainFormation.add("Cargo");
        trainFormation.add("Guard");

        // Attempt to attach a duplicate bogie
        trainFormation.add("Sleeper"); // duplicate ignored automatically

        // Display final formation
        System.out.println("Final train formation (in insertion order): " + trainFormation);
    }
}
